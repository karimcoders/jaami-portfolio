generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Singleton row (id = "main") — hero / profile / section copy / theme / SEO
model SiteSettings {
  id            String   @id @default("main")
  name          String   @default("JAAMI")
  tagline       String   @default("Creative Video Editor")
  about         String   @default("")
  avatarUrl     String   @default("/assets/media/aabd43f4a629a999c77dde1681c06808.png")
  whatsappUrl   String   @default("https://wa.me/917780015030")
  stats         String   @default("[]") // JSON string[]
  shortSubtitle String   @default("Scroll-stopping reels, shorts & vertical content")
  longSubtitle  String   @default("Story-driven long form edits & brand films")
  contactIntro  String   @default("Have a project in mind? Let's turn your raw ideas into scroll-stopping content. Reach out through any of the channels below.")
  // Branding
  logoUrl       String   @default("") // empty = text brand (name)
  faviconUrl    String   @default("")
  // Theme colors (WordPress-style customizer)
  colorOlive     String  @default("#778667") // primary
  colorOliveDark String  @default("#5f6d52") // hover / footer
  colorSage      String  @default("#d9e6ca") // page background
  colorMist      String  @default("#eef3e5") // light panel background
  colorInk       String  @default("#4a5442") // main text
  colorCream     String  @default("#f4f7ee") // light text
  // Typography preset: fraunces | playfair | dmserif | modern
  fontPreset    String   @default("fraunces")
  // Section visibility
  showMarquee   Boolean  @default(true)
  showStats     Boolean  @default(true)
  showShort     Boolean  @default(true)
  showLong      Boolean  @default(true)
  showContact   Boolean  @default(true)
  // SEO / footer
  seoTitle       String  @default("JAAMI | Creative Video Editor")
  seoDescription String  @default("Creative and detail-oriented short form & long form video editor with 2 years of experience specializing in storytelling and visual communication. Turning raw ideas into scroll-stopping content.")
  footerText     String  @default("")
  updatedAt     DateTime @updatedAt
}

// WordPress-style editable pages — blocks JSON rendered on /{slug}
model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  blocks    String   @default("[]") // JSON Block[]
  showInNav Boolean  @default(true)
  visible   Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Portfolio videos — type: "short" | "long"
model Video {
  id        String   @id @default(cuid())
  title     String   @default("") // internal label (admin only)
  type      String   @default("short")
  src       String
  visible   Boolean  @default(true)
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Contact channel items — type: "instagram" | "email" | "whatsapp" | "link"
model ContactItem {
  id      String  @id @default(cuid())
  type    String  @default("link")
  label   String
  href    String
  visible Boolean @default(true)
  sort    Int     @default(0)
}

// Singleton row (id = "main") — admin password (sha256)
model AdminConfig {
  id           String   @id @default("main")
  passwordHash String
  updatedAt    DateTime @updatedAt
}

// Visitor analytics — one row per page view (duration updated via heartbeat)
model PageView {
  id           String   @id @default(cuid())
  visitorId    String // random UUID persisted in visitor's localStorage
  sessionId    String // random UUID per browser session
  path         String   @default("/")
  referrer     String   @default("") // raw referrer url
  referrerHost String   @default("") // cleaned source: "direct" | "google.com" | ...
  country      String   @default("Unknown")
  countryCode  String   @default("")
  city         String   @default("")
  device       String   @default("Desktop") // Desktop | Mobile | Tablet
  browser      String   @default("Unknown")
  os           String   @default("Unknown")
  screen       String   @default("") // "390x844"
  language     String   @default("")
  durationSec  Int      @default(0) // engaged seconds on page
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([sessionId])
  @@index([path])
}

// Custom events — video plays, contact clicks, CTA clicks
model TrackEvent {
  id        String   @id @default(cuid())
  visitorId String
  sessionId String
  name      String // video_play | contact_click | cta_click
  label     String   @default("") // video filename / contact label / button name
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@index([name])
  @@index([createdAt])
}
